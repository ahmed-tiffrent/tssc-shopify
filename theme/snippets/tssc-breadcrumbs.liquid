{% comment %}
  Visible breadcrumbs and matching BreadcrumbList schema for indexable content.
  Search and utility pages are deliberately excluded.
{% endcomment %}
{% liquid
  assign show_breadcrumbs = false
  assign home_url = request.origin | append: routes.root_url
  assign current_url = canonical_url

  case request.page_type
    when 'product', 'collection', 'page', 'blog', 'article'
      assign show_breadcrumbs = true
  endcase
%}

{% if show_breadcrumbs %}
  <nav class="tssc-breadcrumbs{% if context == 'product' %} tssc-breadcrumbs--product{% endif %}" aria-label="Breadcrumb">
    <ol class="tssc-breadcrumbs__list" role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {% if request.page_type == 'product' %}
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li aria-current="page">{{ product.title | escape }}</li>
      {% elsif request.page_type == 'collection' %}
        <li aria-current="page">{{ collection.title | escape }}</li>
      {% elsif request.page_type == 'page' %}
        <li aria-current="page">{{ page.title | escape }}</li>
      {% elsif request.page_type == 'blog' %}
        <li aria-current="page">{{ blog.title | escape }}</li>
      {% elsif request.page_type == 'article' %}
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li aria-current="page">{{ article.title | escape }}</li>
      {% endif %}
    </ol>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ home_url | json }}
        }{% if request.page_type == 'product' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Shop",
          "item": {{ request.origin | append: routes.all_products_collection_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": {{ current_url | json }}
        }{% elsif request.page_type == 'article' %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ request.origin | append: blog.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": {{ current_url | json }}
        }{% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {% if request.page_type == 'collection' %}{{ collection.title | json }}{% elsif request.page_type == 'page' %}{{ page.title | json }}{% else %}{{ blog.title | json }}{% endif %},
          "item": {{ current_url | json }}
        }{% endif %}
      ]
    }
  </script>
{% endif %}
