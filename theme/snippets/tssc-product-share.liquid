{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign share_url = shop.url | append: product.url | append: '?variant=' | append: selected_variant.id
  assign share_id = 'TsscProductShare-' | append: section_id
%}

<script src="{{ 'tssc-product-share.js' | asset_url }}" defer="defer"></script>

<details
  class="tssc-product-share"
  data-product-share
  data-product-url="{{ shop.url }}{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
>
  <summary
    class="tssc-product-share__trigger"
    aria-controls="{{ share_id }}"
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <circle cx="18" cy="5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <circle cx="6" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <circle cx="18" cy="19" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span>Share</span>
  </summary>

  <div class="tssc-product-share__popover" id="{{ share_id }}">
    <p class="tssc-product-share__heading">Share this product</p>
    <div class="tssc-product-share__links">
      <button type="button" data-product-share-copy>Copy link</button>
      <a href="mailto:?subject={{ product.title | url_encode }}&body={{ share_url | url_encode }}" data-product-share-link="email">Email</a>
      <a href="https://wa.me/?text={{ product.title | append: ' ' | append: share_url | url_encode }}" target="_blank" rel="noopener" data-product-share-link="whatsapp">WhatsApp</a>
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" data-product-share-link="facebook">Facebook</a>
      <a href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" data-product-share-link="pinterest">Pinterest</a>
      <a href="https://twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ share_url | url_encode }}" target="_blank" rel="noopener" data-product-share-link="x">X</a>
    </div>
    <p class="tssc-product-share__status" role="status" aria-live="polite" data-product-share-status></p>
  </div>
</details>

{% stylesheet %}
  .tssc-product-utility-actions {
    position: relative;
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 20px;
    flex-wrap: wrap;
  }

  .tssc-product-utility-actions .tssc-product-favourite {
    width: auto;
  }

  .tssc-product-share {
    position: relative;
  }

  .tssc-product-share summary::-webkit-details-marker {
    display: none;
  }

  .tssc-product-share__trigger {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    padding: 7px 2px;
    list-style: none;
    font-family: var(--font-paragraph--family);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    cursor: pointer;
  }

  .tssc-product-share__trigger svg {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
  }

  .tssc-product-share__trigger span {
    border-bottom: 1px solid transparent;
  }

  .tssc-product-share__trigger:hover span,
  .tssc-product-share[open] .tssc-product-share__trigger span {
    border-bottom-color: currentColor;
  }

  .tssc-product-share__trigger:focus-visible,
  .tssc-product-share__popover :is(a, button):focus-visible {
    outline: 3px solid #962648;
    outline-offset: 3px;
  }

  .tssc-product-share__popover {
    position: absolute;
    z-index: var(--layer-raised, 10);
    top: calc(100% + 8px);
    right: 0;
    width: min(260px, calc(100vw - 32px));
    padding: 18px;
    border: 1px solid rgb(50 21 29 / 22%);
    background: #fff;
    box-shadow: 0 10px 28px rgb(50 21 29 / 14%);
  }

  .tssc-product-share__heading {
    margin: 0 0 12px;
    font-weight: 600;
  }

  .tssc-product-share__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 16px;
  }

  .tssc-product-share__links :is(a, button) {
    min-height: 44px;
    padding: 10px 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .tssc-product-share__status {
    display: flex;
    min-height: 0;
    margin: 0;
    align-items: center;
    gap: 8px;
    color: #6f1d3a;
    background: #f9edf1;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  .tssc-product-share__status:not(:empty) {
    min-height: 40px;
    margin-top: 12px;
    padding: 9px 12px;
  }

  .tssc-product-share__status:not(:empty)::before {
    content: '✓';
    flex: 0 0 auto;
  }

  @media screen and (max-width: 479px) {
    .tssc-product-utility-actions {
      gap: 12px;
    }

    .tssc-product-share__popover {
      right: auto;
      left: 0;
      width: min(280px, calc(100vw - 32px));
    }
  }
{% endstylesheet %}
