<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  assign product_limit = section.settings.products_to_show | default: 4
  assign current_product = section.settings.product | default: product
%}

<product-recommendations
  id="TsscBrowseProducts-{{ section.id }}"
  class="tssc-browse-products product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ product_limit }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-intent="related"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="tssc-browse-products-{{ section.id }}"
  style="
    --browse-products-background: {{ section.settings.background_color }};
    --browse-products-text: {{ section.settings.text_color }};
    --browse-products-image-background: {{ section.settings.image_background_color }};
    --browse-products-padding-top: {{ section.settings.padding_top }}px;
    --browse-products-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  {{ section.shopify_attributes }}
>
  <section aria-labelledby="TsscBrowseProductsHeading-{{ section.id }}">
    <div class="tssc-browse-products__inner">
      <h3 id="TsscBrowseProductsHeading-{{ section.id }}" class="tssc-browse-products__heading">
        <span>{{ section.settings.heading | escape }}</span>
        {% if section.settings.italic_heading != blank %}
          <em>{{ section.settings.italic_heading | escape }}</em>
        {% endif %}
      </h3>

      {% if recommendations.performed %}
        {% liquid
          assign related_products = recommendations.products
          if recommendations.products_count == 0
            assign related_products = collections.all.products | reject: 'id', current_product.id
          endif

          if related_products != blank and related_products.size > 0
            assign has_recommendations = 'true'
          else
            assign has_recommendations = 'false'
          endif
        %}

        <ul
          class="tssc-browse-products__grid"
          role="list"
          data-has-recommendations="{{ has_recommendations }}"
        >
          {% for related_product in related_products limit: product_limit %}
            {% unless related_product.id == current_product.id %}
              {% liquid
                assign card_variant = related_product.selected_or_first_available_variant
                assign card_colour_option_index = nil

                for card_option in related_product.options_with_values
                  assign card_option_name = card_option.name | downcase | strip
                  if card_option_name == 'colour' or card_option_name == 'color'
                    assign card_colour_option_index = card_option.position | minus: 1
                    break
                  endif
                endfor

                comment
                  Keep the image, colour heading, link, price and form on the
                  same variant. If the default variant has no linked photo,
                  prefer an available photographed variant. Products with only
                  a generic image deliberately omit the colour heading.
                endcomment
                if card_variant.featured_image == blank
                  for candidate_variant in related_product.variants
                    if candidate_variant.available and candidate_variant.featured_image != blank
                      assign card_variant = candidate_variant
                      break
                    endif
                  endfor
                endif

                assign card_image = card_variant.featured_image | default: related_product.featured_media.preview_image | default: related_product.featured_image
                assign card_colour = blank
                assign hide_card_colour = true
                if card_variant.featured_image != blank and card_colour_option_index != nil
                  assign card_colour = card_variant.options[card_colour_option_index]
                  assign hide_card_colour = false
                endif
                assign card_product_url = related_product.url | split: '?' | first
                assign card_url = card_product_url | append: '?variant=' | append: card_variant.id
                assign card_image_alt = card_image.alt | default: related_product.title
                if card_colour != blank
                  assign card_image_alt = card_image_alt | append: ' in ' | append: card_colour
                endif
              %}

              <li class="tssc-browse-products__item">
                <article class="tssc-browse-products__card">
                  {% render 'tssc-wishlist-button',
                    product: related_product,
                    variant: card_variant,
                    colour: card_colour
                  %}

                  <a
                    class="tssc-browse-products__card-link"
                    href="{{ card_url }}"
                    aria-label="View {{ related_product.title | escape }}"
                  >
                    <span class="tssc-browse-products__media">
                      {% if card_image != blank %}
                        {{
                          card_image
                          | image_url: width: 1000
                          | image_tag:
                            loading: 'lazy',
                            widths: '240, 360, 480, 640, 800, 1000',
                            sizes: '(min-width: 1200px) 25vw, (min-width: 480px) 50vw, 100vw',
                            class: 'tssc-browse-products__image',
                            alt: card_image_alt
                        }}
                      {% else %}
                        <span class="tssc-browse-products__placeholder" aria-hidden="true">
                          {{ 'product-1' | placeholder_svg_tag }}
                        </span>
                      {% endif %}
                    </span>
                  </a>

                  <div class="tssc-browse-products__content">
                    {% render 'tssc-product-card-info',
                      product: related_product,
                      variant: card_variant,
                      colour: card_colour,
                      hide_colour_heading: hide_card_colour
                    %}
                  </div>
                </article>
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      {% else %}
        <div class="tssc-browse-products__grid tssc-browse-products__grid--loading" role="status">
          <span class="visually-hidden">Loading related products</span>
          {% for index in (1..product_limit) %}
            <span class="tssc-browse-products__skeleton" aria-hidden="true"></span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
</product-recommendations>

{% style %}
  #TsscBrowseProducts-{{ section.id }},
  #TsscBrowseProducts-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TsscBrowseProducts-{{ section.id }} {
    display: block;
    width: 100%;
    color: var(--browse-products-text);
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__inner {
    width: min(100%, 1600px);
    margin-inline: auto;
    padding: var(--browse-products-padding-top) clamp(20px, 4vw, 64px) var(--browse-products-padding-bottom);
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.22em;
    margin: 0 0 clamp(40px, 5vw, 64px);
    color: var(--browse-products-text);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(34px, 3.35vw, 48px);
    font-weight: var(--font-h3--weight, 400);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    line-height: 1.12;
    text-align: center;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__heading em {
    font-style: italic;
    font-weight: inherit;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 32px);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__item {
    min-width: 0;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__card {
    width: 100%;
    margin: 0;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__card-link {
    display: block;
    color: var(--browse-products-text);
    text-decoration: none;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__media {
    display: block;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--browse-products-image-background);
  }

  #TsscBrowseProducts-{{ section.id }} :is(.tssc-browse-products__image, .tssc-browse-products__placeholder, .tssc-browse-products__placeholder svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__image {
    object-fit: cover;
    transition: transform 250ms ease;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__card-link:hover .tssc-browse-products__image {
    transform: scale(1.015);
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__content {
    display: block;
    padding: 20px 12px 0;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__title {
    margin: 0;
    color: var(--browse-products-text);
    font-family: var(--font-h4--family, var(--font-heading--family));
    font-size: var(--font-h4--size, 24px);
    font-weight: var(--font-h4--weight, 400);
    line-height: var(--font-h4--line-height, 1.25);
    overflow-wrap: anywhere;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__price {
    display: block;
    margin-top: 16px;
    color: var(--browse-products-text);
    font-family: var(--font-paragraph--family);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__card-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__skeleton {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1.22;
    background: linear-gradient(100deg, #eceff3 20%, #f7f8fa 40%, #eceff3 60%);
    background-size: 200% 100%;
    animation: tssc-browse-products-loading 1.3s ease-in-out infinite;
  }

  @keyframes tssc-browse-products-loading {
    from { background-position: 100% 0; }
    to { background-position: -100% 0; }
  }

  @media screen and (max-width: 1199px) {
    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__inner {
      padding: min(var(--browse-products-padding-top), 56px) 20px min(var(--browse-products-padding-bottom), 56px);
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__heading {
      justify-content: flex-start;
      margin-bottom: 32px;
      font-size: clamp(32px, 9vw, 40px);
      text-align: left;
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__grid {
      gap: 32px 16px;
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__content {
      padding: 16px 4px 0;
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__title {
      font-size: clamp(16px, 4.25vw, 19px) !important;
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__price {
      margin-top: 12px;
      font-size: 18px;
    }
  }

  @media screen and (max-width: 479px) {
    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__inner {
      padding-inline: 16px;
    }

    #TsscBrowseProducts-{{ section.id }} .tssc-browse-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TsscBrowseProducts-{{ section.id }} *,
    #TsscBrowseProducts-{{ section.id }} *::before,
    #TsscBrowseProducts-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "TSSC Browse products",
  "tag": "div",
  "class": "tssc-browse-products-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Leave blank to use the product currently being viewed."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse Other"
    },
    {
      "type": "text",
      "id": "italic_heading",
      "label": "Italic heading text",
      "default": "Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F8FB"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image background",
      "default": "#F4F5F7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#32151D"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "TSSC Browse products"
    }
  ]
}
{% endschema %}
