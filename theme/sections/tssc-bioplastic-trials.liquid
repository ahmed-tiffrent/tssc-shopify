<section
  id="TsscBioplasticTrials-{{ section.id }}"
  class="tssc-bioplastic-trials"
  aria-labelledby="TsscBioplasticTrialsHeading-{{ section.id }}"
  style="
    --bioplastic-background: {{ section.settings.background_color }};
    --bioplastic-text: {{ section.settings.text_color }};
    --bioplastic-caption: {{ section.settings.caption_color }};
    --bioplastic-padding-top: {{ section.settings.padding_top }}px;
    --bioplastic-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tssc-bioplastic-trials__inner">
    <div class="tssc-bioplastic-trials__content">
      <h3 id="TsscBioplasticTrialsHeading-{{ section.id }}" class="tssc-bioplastic-trials__heading">
        <span>{{ section.settings.heading | escape }}</span>
        {% if section.settings.italic_heading != blank %}
          <em>{{ section.settings.italic_heading | escape }}</em>
        {% endif %}
      </h3>

      {% if section.settings.text != blank %}
        <div class="tssc-bioplastic-trials__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    <figure class="tssc-bioplastic-trials__figure">
      <div class="tssc-bioplastic-trials__media">
        {% if section.settings.image_url != blank %}
          <img
            class="tssc-bioplastic-trials__image"
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.image_alt | escape }}"
            width="2228"
            height="2344"
            loading="lazy"
            decoding="async"
          >
        {% else %}
          <div class="tssc-bioplastic-trials__placeholder" aria-hidden="true">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.caption != blank %}
        <figcaption class="tssc-bioplastic-trials__caption">
          {{ section.settings.caption | escape }}
        </figcaption>
      {% endif %}
    </figure>
  </div>
</section>

{% style %}
  #TsscBioplasticTrials-{{ section.id }},
  #TsscBioplasticTrials-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TsscBioplasticTrials-{{ section.id }} {
    width: 100%;
    padding-block: var(--bioplastic-padding-top) var(--bioplastic-padding-bottom);
    color: var(--bioplastic-text);
    background: var(--bioplastic-background);
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.9fr);
    grid-template-areas: 'figure content';
    gap: clamp(64px, 9vw, 136px);
    align-items: center;
    width: min(100%, 1320px);
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 72px);
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__content {
    grid-area: content;
    min-width: 0;
    max-width: 520px;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__heading {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.22em;
    margin: 0 0 clamp(24px, 3vw, 36px);
    color: var(--bioplastic-text);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(34px, 3.35vw, 48px);
    font-weight: var(--font-h3--weight, 400);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    line-height: 1.12;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__heading em {
    font-style: italic;
    font-weight: inherit;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__text {
    color: var(--bioplastic-text);
    font-family: var(--font-paragraph--family);
    font-size: 16px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__text p {
    margin: 0;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__text p + p {
    margin-top: 20px;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__figure {
    grid-area: figure;
    width: 100%;
    max-width: 520px;
    margin: 0;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__media {
    width: 100%;
    overflow: hidden;
    aspect-ratio: 2228 / 2344;
    background: #f5f5f5;
  }

  #TsscBioplasticTrials-{{ section.id }} :is(.tssc-bioplastic-trials__image, .tssc-bioplastic-trials__placeholder, .tssc-bioplastic-trials__placeholder svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__image {
    object-fit: cover;
  }

  #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__caption {
    margin-top: 12px;
    color: var(--bioplastic-caption);
    font-family: var(--font-paragraph--family);
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
  }

  #TsscBioplasticTrials-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (min-width: 1441px) {
    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
      padding-inline: 64px;
    }
  }

  @media screen and (max-width: 1023px) {
    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 0.95fr);
      gap: 56px;
      padding-inline: 40px;
    }
  }

  @media screen and (max-width: 799px) {
    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'content'
        'figure';
      gap: 40px;
    }

    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__content {
      max-width: 65ch;
    }

    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__figure {
      width: min(100%, 520px);
    }
  }

  @media screen and (max-width: 749px) {
    #TsscBioplasticTrials-{{ section.id }} {
      padding-block: min(var(--bioplastic-padding-top), 56px) min(var(--bioplastic-padding-bottom), 56px);
    }

    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
      gap: 32px;
      padding-inline: 20px;
    }

    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__heading {
      margin-bottom: 24px;
      font-size: clamp(32px, 9vw, 40px);
    }
  }

  @media screen and (max-width: 479px) {
    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__inner {
      padding-inline: 16px;
    }

    #TsscBioplasticTrials-{{ section.id }} .tssc-bioplastic-trials__text p + p {
      margin-top: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TsscBioplasticTrials-{{ section.id }} *,
    #TsscBioplasticTrials-{{ section.id }} *::before,
    #TsscBioplasticTrials-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "TSSC Bioplastic trials",
  "tag": "div",
  "class": "tssc-bioplastic-trials-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "First Bioplastic"
    },
    {
      "type": "text",
      "id": "italic_heading",
      "label": "Italic heading text",
      "default": "Trials"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Rachel has always loved textiles, studying embroidery before working as a print and embroidery swatch designer, embroidery technician and sustainable fashion tutor. Her interest in sequins grew while she was completing an MA in Fashion and the Environment at London College of Fashion in 2012.</p><p>During that research-led MA, she created naturally coloured, biobased polymer sequins as part of an experiment in how embellishment could respond to the short lifespan of fast fashion garments. These early sequins were designed to dissolve after a few wears, releasing natural dye into the fabric and creating a “new” version of the garment.</p>"
    },
    {
      "type": "url",
      "id": "image_url",
      "label": "Image URL"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "default": "Overlapping experimental bioplastic sequins in muted yellow, blue and coral tones"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption",
      "default": "Bioplastic developed during MA 2012"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#32151D"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption",
      "default": "#696166"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "TSSC Bioplastic trials",
      "category": "TSSC",
      "settings": {
        "image_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/Bioplastic_trials.webp?v=1787681305"
      }
    }
  ]
}
{% endschema %}
