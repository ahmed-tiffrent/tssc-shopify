{%- liquid
  assign section_title = section.settings.title | default: 'Built For Serious Makers'
  assign title_words = section_title | split: ' '
  assign title_last_index = title_words.size | minus: 1
-%}

<section class="tssc-built-makers" id="tssc-built-makers-{{ section.id }}" aria-labelledby="tssc-built-makers-title-{{ section.id }}">
  <div class="tssc-built-makers__content">
    <h3 class="tssc-built-makers__title" id="tssc-built-makers-title-{{ section.id }}">
      {%- for word in title_words -%}
        {%- if forloop.index0 == title_last_index -%}
          <em>{{ word }}</em>
        {%- else -%}
          {{ word }}
        {%- endif -%}
        {%- unless forloop.last %} {% endunless -%}
      {%- endfor -%}
    </h3>

    {%- if section.settings.text != blank -%}
      <div class="tssc-built-makers__text rte">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
  </div>

  <div class="tssc-built-makers__gallery" aria-label="Maker gallery">
    <div class="tssc-built-makers__track" data-gallery-track>
      {%- for block in section.blocks -%}
        <figure class="tssc-built-makers__slide" {{ block.shopify_attributes }}>
          <img
            src="{{ block.settings.image_url }}"
            alt="{{ block.settings.image_alt | default: 'Maker project using sustainable sequins' | escape }}"
            loading="lazy"
            width="900"
            height="900"
          >
        </figure>
      {%- endfor -%}

      {%- for block in section.blocks -%}
        <figure class="tssc-built-makers__slide" aria-hidden="true">
          <img
            src="{{ block.settings.image_url }}"
            alt="{{ block.settings.image_alt | default: 'Maker project using sustainable sequins' | escape }}"
            loading="lazy"
            width="900"
            height="900"
          >
        </figure>
      {%- endfor -%}
    </div>
  </div>

  <button class="tssc-built-makers__motion-control" type="button" data-motion-control aria-pressed="false">
    <span data-motion-label>Pause gallery motion</span>
  </button>
</section>

<style>
  #tssc-built-makers-{{ section.id }} {
    --built-makers-text: #32151d;
    color: var(--built-makers-text);
    background: var(--color-background);
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__content {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(34px, 4.4vw, 64px) 24px clamp(48px, 5.7vw, 84px);
    text-align: center;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__title {
    margin: 0 0 19px;
    color: inherit;
    font-family: var(--font-h3--family, var(--font-h2--family));
    font-size: clamp(2.25rem, 3.25vw, 3.25rem);
    font-style: var(--font-h3--style, var(--font-h2--style));
    font-weight: var(--font-h3--weight, var(--font-h2--weight));
    letter-spacing: var(--font-h3--letter-spacing, var(--font-h2--letter-spacing));
    line-height: 1.1;
    text-transform: var(--font-h3--case, var(--font-h2--case));
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__title em {
    font-style: italic;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__text {
    max-width: 680px;
    margin: 0 auto;
    font-family: var(--font-paragraph--family);
    font-size: var(--font-paragraph--size, 16px);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    letter-spacing: .025em;
    line-height: 1.55;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__text p {
    margin: 0;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__gallery {
    width: 100%;
    overflow: hidden;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__track {
    display: flex;
    width: max-content;
    animation: tssc-built-makers-scroll-{{ section.id }} 40s linear infinite;
    will-change: transform;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__slide {
    flex: 0 0 25vw;
    width: 25vw;
    min-width: 0;
    aspect-ratio: 1 / 1;
    margin: 0;
    overflow: hidden;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__gallery:hover .tssc-built-makers__track,
  #tssc-built-makers-{{ section.id }} .tssc-built-makers__gallery:focus-within .tssc-built-makers__track,
  #tssc-built-makers-{{ section.id }}.is-paused .tssc-built-makers__track {
    animation-play-state: paused;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__motion-control {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  #tssc-built-makers-{{ section.id }} .tssc-built-makers__motion-control:focus-visible {
    position: fixed;
    z-index: 10;
    top: 16px;
    left: 16px;
    width: auto;
    height: auto;
    padding: 10px 14px;
    margin: 0;
    overflow: visible;
    clip: auto;
    color: var(--color-background);
    background: var(--built-makers-text);
    outline: 2px solid var(--built-makers-text);
    outline-offset: 2px;
  }

  @keyframes tssc-built-makers-scroll-{{ section.id }} {
    to { transform: translateX(-50%); }
  }

  @media screen and (max-width: 989px) {
    #tssc-built-makers-{{ section.id }} .tssc-built-makers__slide {
      flex-basis: 33.333vw;
      width: 33.333vw;
    }
  }

  @media screen and (max-width: 749px) {
    #tssc-built-makers-{{ section.id }} .tssc-built-makers__content {
      padding-right: 20px;
      padding-bottom: 42px;
      padding-left: 20px;
    }

    #tssc-built-makers-{{ section.id }} .tssc-built-makers__title {
      margin-bottom: 15px;
      font-size: clamp(2rem, 9.25vw, 2.6rem);
    }

    #tssc-built-makers-{{ section.id }} .tssc-built-makers__text {
      letter-spacing: .015em;
      line-height: 1.5;
    }

    #tssc-built-makers-{{ section.id }} .tssc-built-makers__slide {
      flex-basis: 72vw;
      width: 72vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tssc-built-makers-{{ section.id }} .tssc-built-makers__track {
      animation: none;
      transform: none;
    }

    #tssc-built-makers-{{ section.id }} .tssc-built-makers__track > :nth-child(n + {{ section.blocks.size | plus: 1 }}) {
      display: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById('tssc-built-makers-{{ section.id }}');
    const control = section?.querySelector('[data-motion-control]');
    const label = section?.querySelector('[data-motion-label]');

    if (!section || !control || !label) return;

    control.addEventListener('click', () => {
      const isPaused = section.classList.toggle('is-paused');
      control.setAttribute('aria-pressed', String(isPaused));
      label.textContent = isPaused ? 'Play gallery motion' : 'Pause gallery motion';
    });
  })();
</script>

{% schema %}
{
  "name": "TSSC Built for Makers",
  "tag": "section",
  "class": "tssc-built-makers-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title (last word italic)",
      "default": "Built For Serious Makers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Paragraph",
      "default": "<p>We make sequins for fashion designers, embroiderers, costume makers, and crafters who want materials that perform as well as they look.</p>"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "url",
          "id": "image_url",
          "label": "Image URL"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSSC Built for Makers",
      "category": "TSSC",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/Rectangle_94.webp?v=1787503724",
            "image_alt": "Fashion models wearing embellished garments"
