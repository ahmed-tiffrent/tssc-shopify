{%- liquid
  assign section_title = section.settings.title | default: 'Made Differently, From the Start'
  assign title_words = section_title | split: ' '
  assign title_last_index = title_words.size | minus: 1
-%}

<section class="tssc-made-differently" id="tssc-made-differently-{{ section.id }}">
  <div class="tssc-made-differently__content">
    <h3 class="tssc-made-differently__title">
      {%- for word in title_words -%}
        {%- if forloop.index0 == title_last_index -%}
          <em>{{ word }}</em>
        {%- else -%}
          {{ word }}
        {%- endif -%}
        {%- unless forloop.last %} {% endunless -%}
      {%- endfor -%}
    </h3>

    {%- if section.settings.intro_text != blank -%}
      <div class="tssc-made-differently__text rte">
        {{ section.settings.intro_text }}
      </div>
    {%- endif -%}
  </div>

  <div class="tssc-made-differently__images">
    <div class="tssc-made-differently__image-wrap">
      <img
        class="tssc-made-differently__image"
        src="{{ section.settings.left_image_url | default: 'https://cdn.shopify.com/s/files/1/0978/1139/8980/files/made_diff_1.webp?v=1787502122' }}"
        alt="{{ section.settings.left_image_alt | escape }}"
        loading="lazy"
        width="1200"
        height="960"
      >
    </div>
    <div class="tssc-made-differently__image-wrap">
      <img
        class="tssc-made-differently__image"
        src="{{ section.settings.right_image_url | default: 'https://cdn.shopify.com/s/files/1/0978/1139/8980/files/made_diff2.webp?v=1787502122' }}"
        alt="{{ section.settings.right_image_alt | escape }}"
        loading="lazy"
        width="1200"
        height="960"
      >
    </div>
  </div>
</section>

<style>
  #tssc-made-differently-{{ section.id }} {
    --made-differently-text: #32151d;
    color: var(--made-differently-text);
    background: var(--color-background);
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__content {
    max-width: 980px;
    margin: 0 auto;
    padding: 10px 24px 38px;
    text-align: center;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__title {
    margin: 0 0 20px;
    color: inherit;
    font-family: var(--font-h3--family, var(--font-h2--family));
    font-size: clamp(2.35rem, 3.45vw, 3.5rem);
    font-style: var(--font-h3--style, var(--font-h2--style));
    font-weight: var(--font-h3--weight, var(--font-h2--weight));
    letter-spacing: var(--font-h3--letter-spacing, var(--font-h2--letter-spacing));
    line-height: 1.1;
    text-transform: var(--font-h3--case, var(--font-h2--case));
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__title em {
    font-style: italic;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__text {
    max-width: 920px;
    margin: 0 auto;
    font-family: var(--font-paragraph--family);
    font-size: var(--font-paragraph--size, 16px);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    letter-spacing: .035em;
    line-height: 1.52;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__text p {
    margin: 0;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__text p + p {
    margin-top: 18px;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__image-wrap {
    aspect-ratio: 5 / 4;
    overflow: hidden;
  }

  #tssc-made-differently-{{ section.id }} .tssc-made-differently__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 1199px) {
    #tssc-made-differently-{{ section.id }} .tssc-made-differently__content {
      max-width: 900px;
      padding-right: 32px;
      padding-left: 32px;
    }
  }

  @media screen and (max-width: 989px) {
    #tssc-made-differently-{{ section.id }} .tssc-made-differently__content {
      padding-top: 32px;
      padding-bottom: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    #tssc-made-differently-{{ section.id }} .tssc-made-differently__content {
      padding: 34px 20px 28px;
    }

    #tssc-made-differently-{{ section.id }} .tssc-made-differently__title {
      margin-bottom: 16px;
      font-size: clamp(2rem, 9.5vw, 2.6rem);
    }

    #tssc-made-differently-{{ section.id }} .tssc-made-differently__text {
      font-size: var(--font-paragraph--size, 16px);
      letter-spacing: .02em;
      line-height: 1.48;
    }

    #tssc-made-differently-{{ section.id }} .tssc-made-differently__text p + p {
      margin-top: 15px;
    }

    #tssc-made-differently-{{ section.id }} .tssc-made-differently__images {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  @media screen and (max-width: 479px) {
    #tssc-made-differently-{{ section.id }} .tssc-made-differently__content {
      padding-right: 16px;
      padding-left: 16px;
    }

    #tssc-made-differently-{{ section.id }} .tssc-made-differently__title {
      font-size: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "TSSC Made Differently",
  "tag": "section",
  "class": "tssc-made-differently-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title (last word italic)",
      "default": "Made Differently, From the Start"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text",
      "default": "<p>Every sequin starts with recycled PET film produced in China. We punch and cut the sequins in our UK workshop, which gives us control over the shapes, sizes and quality of the finished pieces.</p><p>This distinction matters to us: the film is produced in China, while the sequin punching and cutting take place in the UK.</p>"
    },
    {
      "type": "url",
      "id": "left_image_url",
      "label": "Left image URL"
    },
    {
      "type": "text",
      "id": "left_image_alt",
      "label": "Left image alt text",
      "default": "Sustainable sequin samples in the studio"
    },
    {
      "type": "url",
      "id": "right_image_url",
      "label": "Right image URL"
    },
    {
      "type": "text",
      "id": "right_image_alt",
      "label": "Team member at The Sustainable Sequin Company studio",
      "default": "Team member at The Sustainable Sequin Company studio"
    }
  ],
  "presets": [
    {
      "name": "TSSC Made Differently",
      "category": "TSSC"
    }
  ]
}
{% endschema %}
