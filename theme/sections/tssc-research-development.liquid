<section
  id="TsscResearchDevelopment-{{ section.id }}"
  class="tssc-research-development"
  aria-labelledby="TsscResearchDevelopmentHeading-{{ section.id }}"
  style="
    --research-background: {{ section.settings.background_color }};
    --research-text: {{ section.settings.text_color }};
    --research-muted: {{ section.settings.caption_color }};
    --research-accent: {{ section.settings.accent_color }};
    --research-line: {{ section.settings.line_color }};
    --research-padding-top: {{ section.settings.padding_top }}px;
    --research-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tssc-research-development__inner">
    <header class="tssc-research-development__header">
      <h3 id="TsscResearchDevelopmentHeading-{{ section.id }}" class="tssc-research-development__heading">
        <span>{{ section.settings.heading | escape }}</span>
        {% if section.settings.italic_heading != blank %}
          <em>{{ section.settings.italic_heading | escape }}</em>
        {% endif %}
      </h3>

      {% if section.settings.intro_text != blank %}
        <div class="tssc-research-development__intro rte">
          {{ section.settings.intro_text }}
        </div>
      {% endif %}
    </header>

    <ol class="tssc-research-development__timeline">
      <li class="tssc-research-development__event tssc-research-development__event--right">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_1 | escape }}</span></h4>
          <span class="tssc-research-development__connector" aria-hidden="true">
            <span class="tssc-research-development__dot"></span>
            <span class="tssc-research-development__line"></span>
            <span class="tssc-research-development__dot"></span>
          </span>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--right">
          {% render 'tssc-research-project', section: section, project_number: 1 %}
        </div>
      </li>

      <li class="tssc-research-development__event tssc-research-development__event--left">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_2 | escape }}</span></h4>
          <span class="tssc-research-development__connector" aria-hidden="true">
            <span class="tssc-research-development__dot"></span>
            <span class="tssc-research-development__line"></span>
            <span class="tssc-research-development__dot"></span>
          </span>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--left">
          {% render 'tssc-research-project', section: section, project_number: 2 %}
        </div>
      </li>

      <li class="tssc-research-development__event tssc-research-development__event--both">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_3 | escape }}</span></h4>
          <span class="tssc-research-development__connector" aria-hidden="true">
            <span class="tssc-research-development__dot"></span>
            <span class="tssc-research-development__line"></span>
            <span class="tssc-research-development__dot"></span>
          </span>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--left tssc-research-development__projects--pair">
          {% render 'tssc-research-project', section: section, project_number: 3 %}
          {% render 'tssc-research-project', section: section, project_number: 5 %}
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--right">
          {% render 'tssc-research-project', section: section, project_number: 4 %}
        </div>
      </li>

      <li class="tssc-research-development__event tssc-research-development__event--right">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_4 | escape }}</span></h4>
          <span class="tssc-research-development__connector" aria-hidden="true">
            <span class="tssc-research-development__dot"></span>
            <span class="tssc-research-development__line"></span>
            <span class="tssc-research-development__dot"></span>
          </span>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--right">
          {% render 'tssc-research-project', section: section, project_number: 6 %}
        </div>
      </li>

      <li class="tssc-research-development__event tssc-research-development__event--left">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_5 | escape }}</span></h4>
          <span class="tssc-research-development__connector" aria-hidden="true">
            <span class="tssc-research-development__dot"></span>
            <span class="tssc-research-development__line"></span>
            <span class="tssc-research-development__dot"></span>
          </span>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--left">
          {% render 'tssc-research-project', section: section, project_number: 7 %}
        </div>
      </li>

      <li class="tssc-research-development__event tssc-research-development__event--right">
        <div class="tssc-research-development__axis">
          <h4 class="tssc-research-development__year"><span>{{ section.settings.year_6 | escape }}</span></h4>
        </div>
        <div class="tssc-research-development__projects tssc-research-development__projects--right tssc-research-development__projects--pair">
          {% render 'tssc-research-project', section: section, project_number: 8 %}
          {% render 'tssc-research-project', section: section, project_number: 9 %}
        </div>
      </li>
    </ol>
  </div>
</section>

{% style %}
  #TsscResearchDevelopment-{{ section.id }},
  #TsscResearchDevelopment-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TsscResearchDevelopment-{{ section.id }} {
    width: 100%;
    padding-block: var(--research-padding-top) var(--research-padding-bottom);
    color: var(--research-text);
    background: var(--research-background);
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__inner {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 72px);
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__header {
    width: min(100%, 660px);
    margin-inline: auto;
    text-align: center;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.22em;
    margin: 0 0 28px;
    color: var(--research-text);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(34px, 3.35vw, 48px);
    font-weight: var(--font-h3--weight, 400);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    line-height: 1.12;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__heading em {
    font-style: italic;
    font-weight: inherit;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__intro {
    color: var(--research-text);
    font-family: var(--font-paragraph--family);
    font-size: 16px;
    line-height: 1.55;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__intro p {
    margin: 0;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__intro p + p {
    margin-top: 18px;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__timeline {
    position: relative;
    display: grid;
    gap: 28px;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__event {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 164px minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: stretch;
    min-height: 220px;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__axis {
    position: relative;
    z-index: 2;
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__year {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 100%;
    min-height: 76px;
    margin: 0;
    padding: 12px 18px;
    color: #ffffff;
    background: var(--research-accent);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(32px, 3vw, 42px);
    font-weight: 400;
    line-height: 1;
    text-align: center;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__connector {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: center;
    min-height: 116px;
    padding: 14px 0 18px;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__year > span {
    display: block;
    line-height: 1;
    transform: translateY(-0.1em);
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__dot {
    display: block;
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--research-accent);
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__line {
    display: block;
    flex: 1 1 auto;
    width: 1px;
    min-height: 64px;
    margin-block: 5px;
    background-image: linear-gradient(to bottom, var(--research-line) 50%, transparent 50%);
    background-size: 1px 10px;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects {
    display: flex;
    gap: clamp(20px, 3vw, 36px);
    align-items: flex-start;
    min-width: 0;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects--left {
    grid-column: 1;
    grid-row: 1;
    justify-content: flex-end;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects--right {
    grid-column: 3;
    grid-row: 1;
    justify-content: flex-start;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project {
    width: min(100%, 180px);
    margin: 0;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide {
    width: min(100%, 360px);
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project-media {
    width: 100%;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f5f5;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide .tssc-research-development__project-media {
    aspect-ratio: 2 / 1;
  }

  #TsscResearchDevelopment-{{ section.id }} :is(.tssc-research-development__project-image, .tssc-research-development__placeholder, .tssc-research-development__placeholder svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project-image {
    object-fit: cover;
  }

  #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__caption {
    margin-top: 12px;
    color: var(--research-muted);
    font-family: var(--font-paragraph--family);
    font-size: 14px;
    line-height: 1.45;
    text-align: center;
    overflow-wrap: anywhere;
  }

  #TsscResearchDevelopment-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 1099px) {
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__inner {
      padding-inline: 40px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__event {
      grid-template-columns: minmax(0, 1fr) 140px minmax(0, 1fr);
      gap: 28px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project {
      width: min(100%, 150px);
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide {
      width: min(100%, 300px);
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects--pair {
      gap: 16px;
    }
  }

  @media screen and (max-width: 799px) {
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__header {
      text-align: left;
      margin-inline: 0;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__heading {
      justify-content: flex-start;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__timeline {
      gap: 48px;
      padding-left: 40px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__timeline::before {
      content: '';
      position: absolute;
      top: 24px;
      bottom: 24px;
      left: 10px;
      width: 1px;
      background-image: linear-gradient(to bottom, var(--research-line) 50%, transparent 50%);
      background-size: 1px 10px;
      transform: none;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__event {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-height: 0;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__axis {
      display: block;
      width: auto;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__connector {
      display: none;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__year {
      width: 140px;
      min-height: 64px;
      font-size: 32px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__year::before {
      content: '';
      position: absolute;
      top: 50%;
      left: -36px;
      width: 12px;
      height: 12px;
      border: 3px solid var(--research-background);
      border-radius: 50%;
      background: var(--research-accent);
      transform: translateY(-50%);
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
      width: 100%;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects--left,
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects--right {
      justify-content: initial;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project,
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide {
      width: 100%;
      max-width: 360px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    #TsscResearchDevelopment-{{ section.id }} {
      padding-block: min(var(--research-padding-top), 56px) min(var(--research-padding-bottom), 56px);
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__inner {
      padding-inline: 20px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__heading {
      margin-bottom: 24px;
      font-size: clamp(32px, 9vw, 40px);
    }
  }

  @media screen and (max-width: 479px) {
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__inner {
      padding-inline: 16px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__timeline {
      padding-left: 32px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__year::before {
      left: -28px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__projects {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project,
    #TsscResearchDevelopment-{{ section.id }} .tssc-research-development__project--wide {
      grid-column: 1;
      width: min(100%, 320px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TsscResearchDevelopment-{{ section.id }} *,
    #TsscResearchDevelopment-{{ section.id }} *::before,
    #TsscResearchDevelopment-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

{% schema %}
