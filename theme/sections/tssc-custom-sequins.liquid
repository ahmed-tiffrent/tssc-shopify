<section class="tssc-custom-sequins" id="tssc-custom-sequins-{{ section.id }}">
  <div class="tssc-custom-sequins__row">
    <div class="tssc-custom-sequins__col tssc-custom-sequins__col--image-left">
      <img
        src="{{ section.settings.image_left | default: 'https://cdn.shopify.com/s/files/1/0978/1139/8980/files/custom_sequins_left.webp?v=1784020753' }}"
        alt="{{ section.settings.image_left_alt | default: 'Custom sequin flowers detail' }}"
        class="tssc-custom-sequins__image tssc-custom-sequins__image--left"
        loading="lazy"
        width="628"
        height="758"
      >
    </div>

    <div class="tssc-custom-sequins__col tssc-custom-sequins__col--content">
      <div class="tssc-custom-sequins__inner">
        <div class="tssc-custom-sequins__image-right-wrap">
          <img
            src="{{ section.settings.image_right | default: 'https://cdn.shopify.com/s/files/1/0978/1139/8980/files/custtom_sequins_right.webp?v=1784020750' }}"
            alt="{{ section.settings.image_right_alt | default: 'Custom embroidered butterfly sample' }}"
            class="tssc-custom-sequins__image tssc-custom-sequins__image--right"
            loading="lazy"
            width="314"
            height="379"
          >
        </div>

        {% assign title_words = section.settings.title | default: 'Custom Sequins for One-of-a-kind Ideas' | split: ' ' %}
        {% assign title_count = title_words.size %}
        <h3 class="tssc-custom-sequins__title">
          {% for word in title_words %}
            {% assign index = forloop.index0 %}
            {% assign remaining = title_count | minus: index %}
            {% if remaining <= 1 %}
              <span class="tssc-italic">{{ word }}</span>
            {% else %}
              {{ word }}
            {% endif %}
            {% unless forloop.last %} {% endunless %}
          {% endfor %}
        </h3>

        <div class="tssc-custom-sequins__body">
          {{ section.settings.description }}
        </div>

        {% if section.settings.button_label != blank %}
          <div class="tssc-custom-sequins__cta">
            <a href="{{ section.settings.button_link | default: routes.root_url }}" class="tssc-text-button">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TSSC Custom sequins",
  "settings": [
    {
      "type": "url",
      "id": "image_left",
      "label": "Left image URL (large)"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "Left image alt text",
      "default": "Custom sequin flowers detail"
    },
    {
      "type": "url",
      "id": "image_right",
      "label": "Right image URL (small)"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "Right image alt text",
      "default": "Custom embroidered butterfly sample"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title (H3, last word italic)",
      "default": "Custom Sequins for One-of-a-kind Ideas"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From small sampling projects to larger production runs, we work on bespoke sequins tailored to your brief. Each sequin is punched and cut in our UK workshop with a focus on flexibility, reduced waste and precise detail.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "TSSC Custom sequins",
      "category": "TSSC",
      "settings": {
        "image_left": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/custom_sequins_left.webp?v=1784020753",
        "image_right": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/custtom_sequins_right.webp?v=1784020750"
      }
    }
  ]
}
{% endschema %}
