<section
  id="TsscNextSteps-{{ section.id }}"
  class="tssc-next-steps"
  aria-labelledby="TsscNextStepsHeading-{{ section.id }}"
  style="
    --next-steps-background: {{ section.settings.background_color }};
    --next-steps-text: {{ section.settings.text_color }};
    --next-steps-padding-top: {{ section.settings.padding_top }}px;
    --next-steps-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tssc-next-steps__inner">
    <h3 id="TsscNextStepsHeading-{{ section.id }}" class="tssc-next-steps__heading">
      {{ section.settings.heading | escape }}
    </h3>

    <div class="tssc-next-steps__layout">
      {% if section.settings.text != blank %}
        <div class="tssc-next-steps__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="tssc-next-steps__collage">
        {% for index in (1..3) %}
          {% liquid
            assign image_url_key = 'image_' | append: index | append: '_url'
            assign image_alt_key = 'image_' | append: index | append: '_alt'
            assign image_url = section.settings[image_url_key]
            assign image_alt = section.settings[image_alt_key]
          %}

          <div class="tssc-next-steps__media tssc-next-steps__media--{{ index }}">
            {% if image_url != blank %}
              <img
                class="tssc-next-steps__image"
                src="{{ image_url }}"
                alt="{{ image_alt | escape }}"
                width="1760"
                height="1120"
                loading="lazy"
                decoding="async"
              >
            {% else %}
              <div class="tssc-next-steps__placeholder" aria-hidden="true">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% style %}
  #TsscNextSteps-{{ section.id }},
  #TsscNextSteps-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TsscNextSteps-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    padding-block: var(--next-steps-padding-top) var(--next-steps-padding-bottom);
    color: var(--next-steps-text);
    background: var(--next-steps-background);
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__inner {
    width: min(100%, 1440px);
    margin-inline: auto;
    padding-inline: clamp(24px, 4.5vw, 72px);
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__heading {
    margin: 0 0 clamp(32px, 4vw, 48px);
    color: var(--next-steps-text);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(34px, 3.35vw, 48px);
    font-weight: var(--font-h3--weight, 400);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    line-height: 1.12;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.34fr) minmax(0, 1fr);
    gap: clamp(48px, 6vw, 88px);
    align-items: stretch;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__text {
    align-self: end;
    max-width: 35ch;
    padding-bottom: clamp(8px, 1vw, 16px);
    font-family: var(--font-paragraph--family);
    font-size: 16px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__text p {
    margin: 0;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__text p + p {
    margin-top: 24px;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__collage {
    position: relative;
    min-width: 0;
    min-height: clamp(430px, 39vw, 560px);
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__media {
    position: absolute;
    width: 49%;
    overflow: hidden;
    aspect-ratio: 11 / 7;
    background: #f5f5f5;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--1 {
    top: 0;
    left: 0;
    z-index: 1;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--2 {
    top: 27%;
    left: 26%;
    z-index: 3;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--3 {
    right: 0;
    bottom: 0;
    z-index: 2;
  }

  #TsscNextSteps-{{ section.id }} :is(.tssc-next-steps__image, .tssc-next-steps__placeholder, .tssc-next-steps__placeholder svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #TsscNextSteps-{{ section.id }} .tssc-next-steps__image {
    object-fit: cover;
  }

  #TsscNextSteps-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (min-width: 1441px) {
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__inner {
      padding-inline: 64px;
    }
  }

  @media screen and (max-width: 1199px) {
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__layout {
      grid-template-columns: minmax(240px, 0.38fr) minmax(0, 1fr);
      gap: 48px;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__collage {
      min-height: clamp(390px, 45vw, 500px);
    }
  }

  @media screen and (max-width: 899px) {
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__inner {
      padding-inline: 40px;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__text {
      max-width: 65ch;
      padding-bottom: 0;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__collage {
      min-height: clamp(430px, 67vw, 600px);
    }
  }

  @media screen and (max-width: 749px) {
    #TsscNextSteps-{{ section.id }} {
      padding-block: min(var(--next-steps-padding-top), 56px) min(var(--next-steps-padding-bottom), 56px);
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__inner {
      padding-inline: 20px;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__heading {
      margin-bottom: 28px;
      font-size: clamp(32px, 9vw, 40px);
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__layout {
      gap: 32px;
    }
  }

  @media screen and (max-width: 549px) {
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__inner {
      padding-inline: 16px;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__collage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      min-height: 0;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media {
      position: relative;
      inset: auto;
      width: 100%;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--1 {
      grid-column: 1 / -1;
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--2,
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--3 {
      grid-column: auto;
    }
  }

  @media screen and (max-width: 359px) {
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__collage {
      grid-template-columns: minmax(0, 1fr);
    }

    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--1,
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--2,
    #TsscNextSteps-{{ section.id }} .tssc-next-steps__media--3 {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TsscNextSteps-{{ section.id }} *,
    #TsscNextSteps-{{ section.id }} *::before,
    #TsscNextSteps-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "TSSC Next steps",
  "tag": "div",
  "class": "tssc-next-steps-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Next Steps On Our Sustainability Journey"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sustainability is not a finished state; it is an ongoing process of improvement.</p><p>For TSSC, the next phase includes expanding the use of 100% recycled plastic where possible, improving transparency around material composition at product level, and continuing to develop bio-based, biodegradable sequins for future launch.</p>"
    },
    {
      "type": "url",
      "id": "image_1_url",
      "label": "First image URL"
    },
    {
      "type": "text",
      "id": "image_1_alt",
      "label": "First image description",
      "default": "Layers of translucent white sequins"
    },
    {
      "type": "url",
      "id": "image_2_url",
      "label": "Second image URL"
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Second image description",
      "default": "Red and white sequins arranged in flowing stripes"
    },
    {
      "type": "url",
      "id": "image_3_url",
      "label": "Third image URL"
    },
    {
      "type": "text",
      "id": "image_3_alt",
      "label": "Third image description",
      "default": "Overlapping blue and white circular sequins"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#32151D"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "TSSC Next steps",
      "category": "TSSC",
      "settings": {
        "image_1_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/next_steps_1.png?v=1787680956",
        "image_2_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/next_steps_2.png?v=1787680957",
        "image_3_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/next_steps_3.png?v=1787680956"
      }
    }
  ]
}
{% endschema %}
