<section
  id="TsscBiobasedSequins-{{ section.id }}"
  class="tssc-biobased-sequins"
  aria-labelledby="TsscBiobasedSequinsHeading-{{ section.id }}"
  style="
    --biobased-background: {{ section.settings.background_color }};
    --biobased-panel: {{ section.settings.panel_color }};
    --biobased-heading: {{ section.settings.heading_color }};
    --biobased-text: {{ section.settings.text_color }};
    --biobased-padding-top: {{ section.settings.padding_top }}px;
    --biobased-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.flower_image_url != blank %}
    <img
      class="tssc-biobased-sequins__flower tssc-biobased-sequins__flower--top"
      src="{{ section.settings.flower_image_url }}"
      alt="Decorative biobased sequin flower"
      aria-hidden="true"
      width="388"
      height="491"
      loading="lazy"
      decoding="async"
    >
  {% endif %}

  <div class="tssc-biobased-sequins__inner">
    <h3 id="TsscBiobasedSequinsHeading-{{ section.id }}" class="tssc-biobased-sequins__heading">
      <span>{{ section.settings.heading | escape }}</span>
      {% if section.settings.italic_heading != blank %}
        <em>{{ section.settings.italic_heading | escape }}</em>
      {% endif %}
    </h3>

    {% if section.blocks.size > 0 %}
      <div class="tssc-biobased-sequins__panel">
        <ul class="tssc-biobased-sequins__list" role="list">
          {% for block in section.blocks %}
            <li class="tssc-biobased-sequins__benefit" {{ block.shopify_attributes }}>
              <svg class="tssc-biobased-sequins__check" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="1.25"/>
                <path d="m10.5 16.2 3.5 3.5 7.6-7.6" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </div>

  {% if section.settings.flower_image_url != blank %}
    <img
      class="tssc-biobased-sequins__flower tssc-biobased-sequins__flower--bottom"
      src="{{ section.settings.flower_image_url }}"
      alt="Decorative biobased sequin flower"
      aria-hidden="true"
      width="388"
      height="491"
      loading="lazy"
      decoding="async"
    >
  {% endif %}
</section>

{% style %}
  #TsscBiobasedSequins-{{ section.id }},
  #TsscBiobasedSequins-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TsscBiobasedSequins-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding-block: var(--biobased-padding-top) var(--biobased-padding-bottom);
    color: var(--biobased-heading);
    background: var(--biobased-background);
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 1800px);
    margin-inline: auto;
    padding-inline: clamp(24px, 3vw, 56px);
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.22em;
    margin: 0 0 clamp(36px, 4.5vw, 56px);
    color: var(--biobased-heading);
    font-family: var(--font-h3--family, var(--font-heading--family));
    font-size: clamp(34px, 3.35vw, 48px);
    font-weight: var(--font-h3--weight, 400);
    letter-spacing: var(--font-h3--letter-spacing, normal);
    line-height: 1.12;
    text-align: center;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__heading em {
    font-style: italic;
    font-weight: inherit;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__panel {
    padding: clamp(32px, 3vw, 40px);
    color: var(--biobased-text);
    background: var(--biobased-panel);
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__list {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(3, auto);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px clamp(24px, 3vw, 48px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__benefit {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    color: var(--biobased-text);
    font-family: var(--font-h4--family, var(--font-heading--family));
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: var(--font-h4--weight, 400);
    line-height: 1.32;
    overflow-wrap: anywhere;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__check {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    margin-top: 1px;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__flower {
    position: absolute;
    z-index: 0;
    width: clamp(76px, 9vw, 124px);
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__flower--top {
    top: -34px;
    right: -12px;
  }

  #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__flower--bottom {
    bottom: -38px;
    left: -14px;
    transform: rotate(180deg);
  }

  #TsscBiobasedSequins-{{ section.id }} :is(a, button):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 1023px) {
    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__inner {
      padding-inline: 48px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__panel {
      padding: 36px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__list {
      gap: 18px 36px;
    }
  }

  @media screen and (max-width: 749px) {
    #TsscBiobasedSequins-{{ section.id }} {
      padding-block: min(var(--biobased-padding-top), 56px) min(var(--biobased-padding-bottom), 56px);
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__inner {
      padding-inline: 20px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__heading {
      margin-bottom: 32px;
      font-size: clamp(32px, 9vw, 40px);
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__panel {
      padding: 28px 24px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__list {
      grid-auto-flow: row;
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__benefit {
      font-size: clamp(18px, 5vw, 21px);
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__flower {
      width: 76px;
      opacity: 0.9;
    }
  }

  @media screen and (max-width: 479px) {
    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__inner {
      padding-inline: 16px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__panel {
      padding: 24px 18px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__benefit {
      gap: 10px;
    }

    #TsscBiobasedSequins-{{ section.id }} .tssc-biobased-sequins__check {
      width: 27px;
      height: 27px;
      flex-basis: 27px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #TsscBiobasedSequins-{{ section.id }} *,
    #TsscBiobasedSequins-{{ section.id }} *::before,
    #TsscBiobasedSequins-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "TSSC Biobased sequins",
  "tag": "div",
  "class": "tssc-biobased-sequins-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Biobased + Biodegradable"
    },
    {
      "type": "text",
      "id": "italic_heading",
      "label": "Italic heading text",
      "default": "Sequins?"
    },
    {
      "type": "url",
      "id": "flower_image_url",
      "label": "Decorative flower image URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#962648"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel",
      "default": "#FFF4F7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Benefits",
      "default": "#32151D"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "A more sustainable benefit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TSSC Biobased sequins",
      "category": "TSSC",
      "settings": {
        "flower_image_url": "https://cdn.shopify.com/s/files/1/0978/1139/8980/files/flower2.webp?v=1787683993"
      },
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "text": "Renewable raw materials."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "A lighter environmental footprint."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Can be composted."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Reduced reliance on fossil-based plastics."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "Less pollution."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "text": "A stronger circular future for embellishment."
          }
        }
      ]
    }
  ]
}
{% endschema %}
