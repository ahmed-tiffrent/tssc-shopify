{% liquid
  assign is_uk = false
  if localization.country.iso_code == 'GB'
    assign is_uk = true
  endif
%}

<div class="tssc-product-delivery" aria-label="Dispatch and delivery estimate" {{ block.shopify_attributes }}>
  <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
    <path d="M3 5.5h11v11H3zM14 9h3.5L21 12.5v4h-7zM6.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM17.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <div>
    <p><strong>Dispatch:</strong> within 2–3 working days.</p>
    {% if is_uk %}
      <p><strong>Estimated UK delivery:</strong> 3–6 working days from ordering.</p>
      <p><strong>International shipping:</strong> available.</p>
    {% else %}
      <p><strong>International delivery:</strong> usually 5–15 working days after dispatch; customs can add time.</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .tssc-product-delivery {
    display: flex;
    width: 100%;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid rgb(50 21 29 / 22%);
    color: #32151d;
    background: #fff;
  }

  .tssc-product-delivery svg {
    width: 25px;
    height: 25px;
    flex: 0 0 25px;
    margin-top: 1px;
  }

  .tssc-product-delivery p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .tssc-product-delivery p + p {
    margin-top: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dispatch and delivery",
  "tag": null,
  "settings": []
}
{% endschema %}
